# General Settings

PROJECT_NAME=tmco
DJANGO_SETTINGS_MODULE=config.settings
SECRET_KEY=changeme-secret-key
DEBUG=True
ALLOWED_HOSTS=*
TIME_ZONE=Asia/Tehran
LANGUAGE_CODE=fa-ir


# Backend (Django DRF)

BACKEND_PORT=8000
STATIC_URL=/static/
MEDIA_URL=/media/


# Frontend (Next.js SSR)

FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://backend:8000/api
NODE_ENV=development


# Database: Postgres

POSTGRES_DB=tmco_db
POSTGRES_USER=tmco_user
POSTGRES_PASSWORD=changeme-db-password
POSTGRES_HOST=db
POSTGRES_PORT=5432


# Redis

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0


# RabbitMQ

RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672


# Celery

CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/0


# Flower (Celery Monitoring)

FLOWER_PORT=5555
FLOWER_BASIC_AUTH=admin:changeme-password


# Email (SMTP)

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.your-domain.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@your-domain.com
EMAIL_HOST_PASSWORD=changeme-email-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@your-domain.com


# Security / Production

CSRF_TRUSTED_ORIGINS=https://your-domain.com,http://localhost
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
